{% endif -%}
{% if type.maxLength is not none -%}
    static constexpr size_t MaximumLength{ {{ type.maxLength }}U };
{% endif -%}
{% if type.pattern is not none -%}
    static constexpr std::string_view Pattern{ {{ type.pattern | tojson }} };
{% endif -%}

    using BaseType<Type>::BaseType;
};

