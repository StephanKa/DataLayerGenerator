#pragma once
#include <dispatcher.h>
#include <array>
#include <cstddef>
#include <limits>
#include <type_traits>

#ifdef DATALAYER_DEBUG_EXPORT
namespace DataLayer::Debug
{
    struct DatapointEntry
    {
        uint16_t id;
        uint16_t size;
        const void *address;
    };

    static_assert(sizeof(DatapointEntry) == 8);
}
#endif

{% macro datapoint(dp) -%}
   {%- if dp.arraySize > 0 -%}
       DataLayer::Detail::make_array<{{ dp.type }}, {{ dp.arraySize }}>(
       {%- if dp.default is number -%}
           {{ dp.default }})
       {%- elif dp.default is string -%}
           {{ dp.type }}::{{ dp.default }})
       {%- else -%}
           {{ dp.default.string }})
       {%- endif -%}
   {%- else %}
       {%- if dp.default is number -%}
           {{ dp.default }}
       {%- elif dp.default is string -%}
           {{ dp.type }}::{{ dp.default }}
       {%- else -%}
           {{ dp.default.string }}
       {%- endif %}
   {%- endif -%}
{%- endmacro %}

{% macro datapointTypeDefinition(dp) -%}
{% if dp.description %}
/**
* {{ dp.description }}
*/
{% endif -%}
constinit DataLayer::DataPoint<
{%- if dp.arraySize > 0 -%}
        std::array<{{ dp.type }}, {{ dp.arraySize }}>
    {%- else -%}
        {{ dp.type }}
    {%- endif -%}
    , {{ dp.group }}Info, 0x{{ "%0x" | format( dp.id | int) }}, Helper::{{ dp.access }}, DataLayer::Version{ {{ dp.version.major }}, {{ dp.version.minor }}, {{ dp.version.build }} }, FixedString{"{{ dp.name }}"}, {{ dp.allowUpgrade }}, {% if dp.migration %}DataLayer::Migration::{{ dp.migration }}{% else %}nullptr{% endif %}{% for legacy_id in dp.renamedFrom %}, 0x{{ "%0x" | format(legacy_id | int) }}{% endfor %}> {{ dp.name }}
    {%- if 'default' in dp -%}
    ({{ datapoint(dp) }})
{%- endif %};
{%- endmacro -%}

{% if types | length > 0 -%}
// defines all custom data types
{% for type in types -%}
struct {{ type.name }} : DataLayer::Detail::BaseType<{{ type.type }}>
{
    using Type = {{ type.type }};
    static constexpr Type Minimum{ {% if type.min %}{{ type.min }}{% else %}std::numeric_limits<Type>::min(){% endif %} };
    static constexpr Type Maximum{ {% if type.max %}{{ type.max }}{% else %}std::numeric_limits<Type>::max(){% endif %} };

    using BaseType<Type>::BaseType;
};

{% endfor %}
{%- endif %}

{% if enums | length > 0 -%}
// defines all enumeration
{% endif -%}
{% for enum in enums -%}
enum class {{ enum.name }} : {{ enum.type }}
{
{%- if enum.autoId %}
{%- for value in enum["values"] %}
    {{ value }},
{%- endfor %}
{%- else %}
{%- for value in enum["values"] | sort(attribute='value') %}
    {{ value.name }} = {{ value.value }},
{%- endfor %}
{%- endif %}
};

constexpr std::array<{{ enum.name }}, {{ enum["values"] | length }}> {{ enum.name }}Range{
{%- if enum.autoId %}
{%- for value in enum["values"] %}
    {{ enum.name }}::{{ value }},
{%- endfor %}
{%- else %}
{%- for value in enum["values"] | sort(attribute='value') %}
    {{ enum.name }}::{{ value.name }},
{%- endfor %}
{%- endif %}
};

{% endfor %}
{% if structs | length > 0 -%}
// defines all custom made structures
{% endif -%}
{% for struct in structs -%}
struct {{ struct.name }}
{
    {%- for parameter in struct.parameter | sort(attribute='name') %}
    {{ parameter.value }} {{ parameter.name }};
    {%- endfor %}
};
{% endfor %}

{% for dp in data_points if dp.migration -%}
namespace DataLayer::Migration
{
bool {{ dp.migration }}(const Version &sourceVersion, std::span<const std::byte> source, std::span<std::byte> destination) noexcept;
}
{% endfor %}

{% if groups | length > 0 -%}
// defines all existing groups
{% endif -%}
{% for group in groups -%}
{% if group.description %}
/**
* {{ group.description }}
*/
{% endif -%}
constexpr DataLayer::GroupInfo<{{ group.baseId }}, FixedString{"{{ group.name }}"}, {{ group.allowUpgrade }}, DataLayer::PersistenceType::{{ group.persistence }}, DataLayer::Version{ {{ group.version.major }}, {{ group.version.minor }}, {{ group.version.build }} }> {{ group.name }}Info;
{% endfor %}

{%- set namespace_name = namespace(value="") %}
{% for dp in data_points|sort(attribute='name')|sort(attribute='namespace') -%}
{%- if dp.namespace|length %}
{%- if dp.namespace != namespace_name.value %}
{%- set namespace_name.value = dp.namespace %}

namespace {{ dp.namespace }}
{
{%- endif %}
{{ datapointTypeDefinition(dp) }}

{%- if dp.namespace != namespace_name.value %}
{%- set namespace_name.value = dp.namespace %}
} // namespace {{ dp.namespace }}
{%- endif %}
{%- else %}
{{ datapointTypeDefinition(dp) }}
{%- endif %}
{%- if namespace_name.value != "" and  loop.last %}
} // namespace {{ namespace_name.value }}
{%- endif %}
{%- endfor %}

{% if group_data_points_mapping | length > 0 -%}
// defines group to datapoint mapping
{%- endif -%}
{%- for group in group_data_points_mapping %}
constexpr DataLayer::GroupDataPointMapping {{ group  }} { {{ group }}Info, {% for parameter in group_data_points_mapping[group] -%}
    {{ parameter }}{% if not loop.last %}, {% endif %}
    {%- endfor %} };
{%- endfor %}

{% for group in groups if group.maxPayloadBytes is not none -%}
{% if group.name in group_data_points_mapping -%}
static_assert(DataLayer::DataPointSize<std::remove_cvref_t<decltype({{ group.name }})>>::payloadBytes <= {{ group.maxPayloadBytes }},
              "{{ group.name }} datapoint payload exceeds maxPayloadBytes");
{% endif -%}
{% endfor %}

#ifdef DATALAYER_MAX_OBJECT_BYTES
static_assert(0U{% for group in group_data_points_mapping -%}
    + DataLayer::DataPointSize<std::remove_cvref_t<decltype({{ group }})>>::objectBytes
{%- endfor %}) <= DATALAYER_MAX_OBJECT_BYTES,
              "DataLayer datapoint objects exceed DATALAYER_MAX_OBJECT_BYTES");
#endif

// Dispatcher is responsible to handling all requests and also generates responses
constexpr DataLayer::Dispatcher Dispatcher { {% for group in group_data_points_mapping -%}
    {{ group }}{% if not loop.last %}, {% endif %}
{%- endfor %} };

#ifdef DATALAYER_DEBUG_EXPORT
extern "C"
{
[[gnu::used, gnu::section(".datalayer_debug")]] inline const DataLayer::Debug::DatapointEntry DataLayerDebugDatapoints[]{
{%- for datapoint in data_points if datapoint.access != 'WRITE_ONLY' %}
    { {% if datapoint.namespace %}{{ datapoint.namespace }}::{% endif %}{{ datapoint.name }}.getId(), static_cast<uint16_t>(sizeof({% if datapoint.namespace %}{{ datapoint.namespace }}::{% endif %}{{ datapoint.name }}())), {% if datapoint.namespace %}{{ datapoint.namespace }}::{% endif %}{{ datapoint.name }}.debugValueAddress() },
{%- else %}
    { 0, 0, nullptr },
{%- endfor %}
};
}
#endif
