{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "Enums": {
      "type": "array",
      "items": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "values": {
              "type": "array",
              "items": [
                {
                  "type": "string"
                }
              ]
            },
            "autoId": {
              "type": "boolean"
            }
          },
          "required": [
            "name",
            "type",
            "values",
            "autoId"
          ]
        }
      ]
    },
    "Groups": {
      "type": "array",
      "items": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "persistence": {
              "type": "string"
            },
            "baseId": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "renamedFrom": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 65535
              }
            },
            "migration": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          },
          "required": [
            "name",
            "persistence",
            "baseId",
            "version"
          ]
        }
      ]
    },
    "Structs": {
      "type": "array",
      "items": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "parameter": {
              "type": "array"
            }
          },
          "required": [
            "name",
            "parameter"
          ]
        }
      ]
    },
    "Datapoints": {
      "type": "array",
      "items": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "group": {
              "type": "string"
            },
            "id": {
              "type": "integer"
            },
            "type": {
              "type": "string"
            },
            "access": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "group",
            "id",
            "type",
            "access",
            "version"
          ]
        }
      ]
    },
    "Types": {
      "type": "array",
      "items": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "min": {},
            "max": {}
          },
          "required": [
            "name",
            "type"
          ]
        }
      ]
    }
  },
  "required": [
    "Enums",
    "Groups",
    "Structs",
    "Datapoints"
  ]
}
